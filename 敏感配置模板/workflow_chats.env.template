# Feishu/Lark app configuration. Fill these locally; do not commit secrets.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Target chat and optional user info.
FEISHU_CHAT_ID=
FEISHU_MY_OPEN_ID=

# Runtime identity: bot is recommended for automation after adding the bot to the group.
FEISHU_IDENTITY=

# Optional lark-cli profile/bin. Leave blank unless you use named profiles.
FEISHU_LARK_PROFILE=
LARK_CLI_BIN=
FEISHU_BRAND=
FEISHU_SETUP_LARK_CLI=

# Message scan filters. Date-only or ISO 8601 both work with lark-cli.
FEISHU_JIELONG_KEYWORD=
FEISHU_SCAN_START=
FEISHU_SCAN_END=
FEISHU_SCAN_PAGES=
FEISHU_PREFER=

# Optional direct Base input. If either is set, the script skips group scanning.
FEISHU_BASE_URL=
FEISHU_BASE_TOKEN=

# Local export output.
FEISHU_OUTPUT_DIR=
FEISHU_FILE_NAME=
FEISHU_OVERWRITE=
FEISHU_DUMP_MESSAGES=
