# Active local config for feishu-bot.
# No app secrets belong here.

JIELONG_BOT_ALLOWED_CHAT_IDS=
# Optional comma-separated groups where only Winston free chat is allowed.
# Registered business commands are silently ignored in these groups.
WINSTON_CHAT_ALLOWED_CHAT_IDS=
# Explicit Feishu 1:1/p2p chat IDs where Winston may receive commands and chat.
# Leave empty to disable private-chat handling; do not use an unrestricted default.
WINSTON_CHAT_ALLOWED_P2P_CHAT_IDS=
JIELONG_BOT_ALLOW_ANY_CHAT=
JIELONG_BOT_COMMAND_CHAT_ALIASES=
JIELONG_BOT_DEFAULT_REPORT_CHAT=

# Command chat and source chat are separate. Leave false unless the command
# group itself also contains the jielong source messages.
JIELONG_BOT_USE_COMMAND_CHAT_AS_SOURCE=
JIELONG_BOT_SOURCE_CHAT_ID=
JIELONG_BOT_DEFAULT_SOURCE_CHAT=

# Routing aliases. Use semicolon-separated name=value pairs.
# source/source-chat = jielong source group. source-base = direct jielong Base.
# base/target-base = target backfill Base.
JIELONG_BOT_SOURCE_CHAT_ALIASES=
JIELONG_BOT_SOURCE_BASE_URL_ALIASES=
JIELONG_BOT_SOURCE_BASE_TOKEN_ALIASES=
JIELONG_BOT_DEFAULT_TARGET_BASE=
JIELONG_BOT_TARGET_BASE_URL_ALIASES=
JIELONG_BOT_TARGET_BASE_TOKEN_ALIASES=

# Legacy aliases retained for older manual commands; prefer the explicit names above.
JIELONG_BOT_CHAT_ALIASES=
JIELONG_BOT_BASE_URL_ALIASES=
JIELONG_BOT_BASE_TOKEN_ALIASES=

JIELONG_BOT_REPLY=
JIELONG_BOT_REQUIRE_AT=
JIELONG_BOT_MENTION_MATCHES=
JIELONG_BOT_EXECUTE_BACKFILL=
JIELONG_BOT_HEARTBEAT_SECONDS=

# Keep exports and relative outputs in the existing workspace.
JIELONG_BOT_WORKDIR=
