# Feishu/Lark app placeholders. Keep secrets local; do not paste them into chat.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Base target.
FEISHU_IDENTITY=
FEISHU_BASE_URL=

# Optional overrides. Leave blank when FEISHU_BASE_URL contains the Base token and table id.
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=

# Backfill target and source workbook.
# Leave BACKFILL_PROJECT blank to use the XLSX filename stem as Project.
# Leave BACKFILL_XLSX_PATH blank to use the newest XLSX in BACKFILL_XLSX_DIR.
# Leave BACKFILL_WORKSHEET blank to use the first worksheet.
BACKFILL_PROJECT=
BACKFILL_XLSX_PATH=
BACKFILL_XLSX_DIR=
BACKFILL_XLSX_GLOB=
BACKFILL_WORKSHEET=

# Matching fields.
BACKFILL_PROJECT_FIELD=
BACKFILL_OWNER_FIELD=
BACKFILL_XLSX_LINK_HEADER=
BACKFILL_XLSX_OWNER_HEADER=

# Safety defaults.
BACKFILL_OVERWRITE=
LARK_CLI_BIN=

# Release activation: private resource coordinates must be supplied here.
# Dedicated read-only source for 海外市场账号. Do not reuse the target Base.
# The table/view should resolve to 海外账号表 / 全部账号 (or documented equivalents)
# and include 账号名称, 国家, 账号链接, 备注, 属性, 大区.
WEEKLY_ACCOUNT_BASE_TOKEN=
WEEKLY_ACCOUNT_SOURCE_TABLE=
WEEKLY_ACCOUNT_SOURCE_VIEW=
